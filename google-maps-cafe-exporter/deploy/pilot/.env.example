# Exact host names that Cloudflare Tunnel sends to the application.
# Exact hosts are isolated first; a later Tunnel route for *.menu-on.com serves
# only sites that are present and active in the pilot registry.
PILOT_PUBLIC_HOSTS=demo.menu-on.com
PILOT_CLIENT_HOSTS=cabinet.menu-on.com
PILOT_OPERATOR_HOSTS=ops.menu-on.com
PILOT_SITE_DOMAIN=menu-on.com
PUBLIC_MENU_ORIGIN=https://demo.menu-on.com

# Shared only by the local operator app and this VPS deployment endpoint.
# Generate with: openssl rand -base64 48
PUBLISH_API_TOKEN=replace-with-a-separate-long-random-secret

# Generate independently with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-unique-long-random-secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Separate credentials for the platform owner panel. Do not reuse a café
# account or its password. OPS_SESSION_SECRET: openssl rand -base64 48
OPS_SESSION_SECRET=replace-with-another-long-random-secret
OPS_EMAIL=owner@example.com
OPS_PASSWORD=replace-with-a-long-unique-password

# Separate encryption key for recoverable cafe-cabinet passwords in the owner
# panel. Generate with: openssl rand -base64 48. Do not rotate it without
# reissuing every cafe password.
SITE_ADMIN_CREDENTIALS_KEY=replace-with-a-dedicated-long-random-secret

# Commercial contact channels. WhatsApp accepts an international number or a
# complete https://wa.me/... link. Leave payment fields empty until a Stripe
# account, immutable legal documents and checkout integration are ready.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Copied from the Cloudflare dashboard after creating a remotely managed tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
