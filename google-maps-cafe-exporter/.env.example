# Порт локального сайта
PORT=3210

# Защита от слишком долгих и дорогих запусков.
MAX_RADIUS_KM=25
MAX_SEARCH_PAGES=36
MAX_RESULTS=120

# Local client-admin login. In production both ADMIN_PASSWORD and a long random
# ADMIN_SESSION_SECRET are required; do not use the local development default.
ADMIN_EMAIL=anna@cafe-harmony.menu
ADMIN_PASSWORD=fastmenu-local
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Platform owner panel. These credentials are separate from every cafe.
OPS_SESSION_SECRET=replace-with-another-long-random-secret-before-production
OPS_EMAIL=owner@example.com
OPS_PASSWORD=replace-with-a-long-unique-password
NODE_ENV=development

# Publication from the local "Прод" interface to the VPS pilot. Keep the
# token in a local .env only; it must match deploy/pilot/.env on the VPS.
PUBLISH_SITE_DOMAIN=menu-on.com
PUBLISH_API_URL=https://cabinet.menu-on.com/api/deploy/published-sites
PUBLISH_API_TOKEN=copy-the-private-pilot-token-here

# The pilot serves the sales landing from the apex of PILOT_SITE_DOMAIN and
# www.<PILOT_SITE_DOMAIN>. Route both hostnames to the same Tunnel service.
